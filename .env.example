# Open-rag.ai Configuration
# Copy this file to .env and fill in your credentials
# Usage: source .env before starting services

# Hugging Face token (required for STT/TTS models)
# Get your token at: https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=

# LLM API configuration
# Note: Do not include /v1 suffix in the URL, it will be added automatically
KYUTAI_LLM_URL=
KYUTAI_LLM_API_KEY=
KYUTAI_LLM_MODEL=

# Max tokens for LLM responses (default: 200)
# Can be overridden per voice in voices.yaml
KYUTAI_LLM_MAX_TOKENS=200

# Optional: Other Unmute environment variables
# NEWSAPI_API_KEY=
# KYUTAI_STT_URL=ws://stt:8080
# KYUTAI_TTS_URL=ws://tts:8080
